# 统一以 LF 换行入库，避免跨平台协作时整文件被标记为「已修改」
* text=auto eol=lf

*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.txt  text eol=lf
*.m    text eol=lf
*.py   text eol=lf

# 二进制资源
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff  binary
*.woff2 binary
*.mp3  binary
*.mp4  binary
